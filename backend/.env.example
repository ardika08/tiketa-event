APP_NAME=Nontix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nontix
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Masa berlaku sesi login partner/staff/admin (MENIT menganggur sebelum token
# dicabut; 0 = tanpa batas). Ini yang mengatur auto-logout — BUKAN
# SESSION_LIFETIME di atas, karena API memakai Bearer token, bukan cookie sesi.
# Staff sengaja paling longgar: petugas scan tidak boleh ter-logout di tengah acara.
NONTIX_SESSION_IDLE_ADMIN=30
NONTIX_SESSION_IDLE_PARTNER=120
NONTIX_SESSION_IDLE_STAFF=480

# Batas absolut (HARI): token mati sendiri sekian hari setelah dibuat,
# meski terus dipakai. 0 = tanpa batas absolut.
NONTIX_SESSION_ABSOLUTE_DAYS=30

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@nontix.id"
MAIL_FROM_NAME="${APP_NAME}"

# ===== Nontix =====
NONTIX_SERVICE_FEE=2000
NONTIX_ORDER_EXPIRY_MINUTES=15
# Masa tenggang sebelum order pending dibatalkan (batas_bayar + N menit).
# Menangkap pembayaran yang masuk mepet deadline saat webhook gateway telat.
NONTIX_EXPIRY_GRACE_MINUTES=5
NONTIX_FRONTEND_URL=http://localhost:5173
# Minimal saldo bersih yang bisa diajukan partner untuk pencairan (Rp)
NONTIX_MIN_PAYOUT=50000

# Origin frontend yang diizinkan mengakses API (pisahkan dengan koma).
# Produksi: https://nontix.id,https://www.nontix.id
CORS_ALLOWED_ORIGINS=*

# Mayar Invoice API (pembayaran)
# Production: https://api.mayar.id/hl/v1  |  Sandbox: https://api.mayar.io/hl/v1
MAYAR_BASE_URL=https://api.mayar.id/hl/v1
MAYAR_API_KEY=
MAYAR_MODE=fake
# Opsional: token rahasia untuk memverifikasi webhook (jika dipasang di Mayar)
MAYAR_CALLBACK_TOKEN=

# Xendit Payment Session v3 (pembayaran)
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_SECRET_KEY=
XENDIT_MODE=test
XENDIT_WEBHOOK_TOKEN=
# Channel yang boleh muncul di halaman Xendit Hosted Checkout (dipisah koma).
# Contoh: QRIS  |  QRIS,BCA,DANA  |  (kosongkan = tampilkan semua channel akun)
# QRIS = potongan per-transaksi paling murah; VA dipotong flat Rp 9.000.
XENDIT_ALLOWED_PAYMENT_CHANNELS=QRIS

# Mailketing SMTP / API (email invoice & e-ticket)
MAILKETING_BASE_URL=https://api.mailketing.co.id
MAILKETING_API_TOKEN=
MAILKETING_MODE=fake

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
