APP_NAME=Nontix
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://apitix.diamcreative.com

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=USER_nontix
DB_USERNAME=USER_nontix
DB_PASSWORD=ISI_PASSWORD_DB

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ===== Nontix =====
NONTIX_SERVICE_FEE=2000
NONTIX_ORDER_EXPIRY_MINUTES=60
NONTIX_FRONTEND_URL=https://tiket.diamcreative.com
CORS_ALLOWED_ORIGINS=https://tiket.diamcreative.com
# Minimal saldo bersih yang bisa diajukan partner untuk pencairan (Rp)
NONTIX_MIN_PAYOUT=50000

# ===== Payment Gateway =====
# Urutan gateway (fallback otomatis): mayar,xendit
NONTIX_GATEWAYS=mayar,xendit

# Mayar
MAYAR_BASE_URL=https://api.mayar.id/hl/v1
MAYAR_API_KEY=ISI_API_KEY_MAYAR
MAYAR_MODE=live
MAYAR_CALLBACK_TOKEN=ISI_TOKEN_RAHASIA

# Xendit (cadangan) - test key xnd_development_ | live key xnd_production_
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_SECRET_KEY=ISI_SECRET_KEY_XENDIT
XENDIT_MODE=test
XENDIT_WEBHOOK_TOKEN=ISI_WEBHOOK_TOKEN_XENDIT

# ===== Email (Mailketing SMTP) =====
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.mailketing.co.id
MAIL_PORT=587
MAIL_USERNAME=ISI_EMAIL_SMTP
MAIL_PASSWORD=ISI_PASSWORD_SMTP
MAIL_FROM_ADDRESS="no-reply@diamcreative.com"
MAIL_FROM_NAME="${APP_NAME}"

MAILKETING_BASE_URL=https://api.mailketing.co.id
MAILKETING_API_TOKEN=
MAILKETING_MODE=live
